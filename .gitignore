# 依赖与构建产物
node_modules/
dist/
dist-baseline/
# 自动标题验收用的标准构建产物（DIST_OUT=dist-standard，脚本会自己重新构建）
dist-standard/
build/
android/build/
android/app/build/
android/.gradle/
android/app/src/main/assets/public/
*.tsbuildinfo

# 密钥与签名（严禁提交）
android/keystore/*
# 例外：只有键名/形状的样例（全部占位值），见 Issue #272
!android/keystore/keystore.properties.example
*.keystore
*.jks
keystore.properties
android/local.properties
# 本机构建环境声明（Issue #273）：模板 build.env.example 入库，实物不入库
build.env
.env
.env.*
*.apk
*.aab

# 测试夹具与临时脚本
docs/acceptance/
.build-*.sh
deploy-check*.png
# 调试截图（不作为发布产物）
docs/ui/debug-*.png

# 杂项
.DS_Store
*.log

# 编辑器/脚本生成的备份文件（不提交）
*.bak-wx-*
*.bak
*.bak.*

# 测试：依赖统一由根 package.json 提供，tests/ 下不再有独立 node_modules
# （历史上曾软链到某台机器的绝对路径，clone 下来跑不了，已删除；别再手动建）
tests/node_modules/
# 测试自己构建的中间产物（DIST_OUT=dist-standard 等）
dist-*/

# dl-release 发布令牌（绝不入仓；见 docs/RELEASE-CHECKLIST.md §4）
*.token
.dl-release-token
dl-release-token*
.config/dl-release/

# #456：跨 runner 判定的运行记录（每个 runner/分片一份，CI 里作为 artifact 上传，不入库）
.flaky-runs/
