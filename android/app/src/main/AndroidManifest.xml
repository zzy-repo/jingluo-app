<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ============================================================
                 外部应用文件导入：打开方式 / 分享（WPS、微信、QQ、系统文件管理器）
                 ============================================================

                 MIME 的真相源是 `src/services/attachments/limits.ts` 的 `SUPPORTED_EXTENSIONS`
                 （当前 .txt / .docx / .pdf），这里逐条展开成清单里的字面量；
                 `tests/unit/external-import.test.mjs` 有一条断言把两边对齐 ——
                 以后给附件加一种格式，忘了改这里就会红。

                 为什么额外补 `application/octet-stream`：WPS / 微信 / QQ 分享时经常把类型报成
                 octet-stream（甚至空串），只报精确 MIME 的话用户点「分享到鲸落」根本看不到我们。
                 接进来之后**由代码按扩展名二次校验**（`ExternalFilePlugin.resolveMime()`），
                 不支持的类型落 `rejected(reason=unsupported)`，不是静默吞掉。

                 为什么**不用** `*/*`：一揽子接会让鲸落出现在所有文件的「打开方式」候选里，
                 抢走本该给图片查看器 / 压缩工具的位置，用户选了才发现「打不开」。
                 宁可少接，也不要假承诺。

                 VIEW 只声明 content / file 两种 scheme，且**不带** BROWSABLE：
                 带 BROWSABLE 会让我们进入浏览器点链接时的「在应用中打开」选择器，与本事无关。 -->

            <!-- 【1】打开方式：content:// / file:// + 四种 MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- 【2】单文件分享（ACTION_SEND / EXTRA_STREAM） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- 【3】多文件分享（ACTION_SEND_MULTIPLE，EXTRA_STREAM 为 ArrayList<Uri>） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>

        <!-- 变体标记名跟着 applicationId 走（Issue #271）：${applicationId} 由 AGP 按
             config/appIdentity.json 生成，不再写死包名。 -->
        <meta-data android:name="${applicationId}.ARTIFACT_VARIANT" android:value="${artifactVariant}" />

        <!-- 回环 consume 标记（Issue #601 闸 1 → 闸 2 的接缝）：只有显式
             -PallowLoopbackConsume=true 且地址真的是回环，build.gradle 才写 "true"。
             dl-release 的 POST /api/v1/release 读这一条：true → 400 LOOPBACK_BUILD_REJECTED
             （该包仅用于本地联调，要 adb reverse tcp:18000 tcp:18000，真机必连不上后端）。
             注意：老包没有这一条，读不到按历史行为放行 —— 所以这条要长期留着，别删。 -->
        <meta-data android:name="${applicationId}.LOOPBACK_CONSUME" android:value="${loopbackConsume}" />

        <!-- 明文 consume 标记（Issue #601 守卫的补正面 → `verify:apk` 第 5 项的读取点）：只有显式
             -PallowInsecureConsume=true 且地址真的是「明文 http 非回环」时，build.gradle 才写 "true"。
             语义与上一条并列、**不合并**：回环 = 真机连不上后端；明文非回环 = 连得上但流量不加密。
             读到 true 的包是 staging 联调包（staging-only）：`pnpm run verify:apk` 不带
             allow-insecure 开关时直接 exit 1，点名「明文联调包，禁止公开分发」。
             注意：老包没有这一条，读不到按 false 处理（向后兼容，与 LOOPBACK_CONSUME 同口径）。 -->
        <meta-data android:name="${applicationId}.INSECURE_CONSUME" android:value="${insecureConsume}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
