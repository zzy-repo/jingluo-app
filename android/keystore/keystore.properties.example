# =============================================================================
# keystore.properties 的唯一样例（Issue #272）
#
# 用法：拷成 android/keystore/keystore.properties 后填真值。真正的
#       keystore.properties 已被 .gitignore 排除，**永远不要提交**；
#       本文件必须保持全部是占位值。
#
#   cp android/keystore/keystore.properties.example android/keystore/keystore.properties
#   chmod 600 android/keystore/keystore.properties     # 只本机可读
#   pnpm run check:keystore                            # 形状门禁（键齐全 / 路径对 / 能读证书）
#
# 两个最容易踩的坑，先看这里：
#   1. 四个 release 键名必须带 `Release` 后缀（`storeFileRelease`，不是 `storeFile`）。
#      键名写错不会「一半生效」：build.gradle 会判定「缺字段」直接中止 release 构建。
#      debug 侧同理，必须带 `Debug` 后缀。
#   2. storeFile* 里的相对路径是相对 **android/app/** 解析的（Gradle 在 app 模块里
#      调 file()），不是相对仓库根、也不是相对 android/。写 `keystore/release.keystore`
#      会指向不存在的 android/app/keystore/… 。推荐直接用绝对路径，省掉这层歧义。
# =============================================================================

# --- 必填：release 签名（4 个键，缺一个 release 构建就中止） -------------------

# storeFileRelease —— release keystore 文件路径。
#   必须指向「已发布证书」那把（SHA-256 e7c5baee…aa8a1）；换证书 = 已装用户无法覆盖升级。
#   相对路径按 android/app/ 解析；用绝对路径最稳。
storeFileRelease=/absolute/path/to/published.keystore

# storePasswordRelease —— keystore 的 store password（不是 key password）。
#   常见错法：把 keyPassword 写到这里；口令里带 # 或 = 时不要加引号（Properties 会当成值的一部分）。
storePasswordRelease=REPLACE_WITH_STORE_PASSWORD

# keyAliasRelease —— 证书在 keystore 里的别名（keytool -list 能看到）。
#   常见错法：填成文件名或 CN；PKCS12 里别名通常只有一个，别照抄别的机器的别名。
keyAliasRelease=REPLACE_WITH_KEY_ALIAS

# keyPasswordRelease —— 该别名私钥的口令。PKCS12 keystore 通常与 store password 相同。
keyPasswordRelease=REPLACE_WITH_KEY_PASSWORD

# --- 可选：debug 签名（同样必须带 Debug 后缀） --------------------------------
# 只在指纹与已发布证书一致时才会被采用，否则 build.gradle 打印告警并忽略。
# 不打算用 debug 签名就把下面四行留空 / 删掉。

storeFileDebug=/absolute/path/to/debug.keystore
storePasswordDebug=REPLACE_WITH_DEBUG_STORE_PASSWORD
keyAliasDebug=REPLACE_WITH_DEBUG_KEY_ALIAS
keyPasswordDebug=REPLACE_WITH_DEBUG_KEY_PASSWORD
