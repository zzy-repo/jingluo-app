# =============================================================================
# build.env.example —— 构建环境声明（GitHub Issue #273）
#
# 用法：
#   cp build.env.example build.env      # build.env 已被 .gitignore 排除，每台机器各一份
#   # 按本机实际情况填路径 / 版本，再 ./build-apk.sh
#
# 生效顺序：**同名环境变量 > build.env > 脚本内兜底默认值**
#   （即 `ANDROID_HOME=/x ./build-apk.sh` 覆盖 build.env 里的值；别把真路径提交进来）
#
# 读这份声明的地方：build-apk.sh（前置闸门）。pnpm build 只需要 NODE_ENV，由
# scripts/build.mjs 在 node 侧设置，与 shell 无关。
# =============================================================================

# Android SDK 根目录：需要 cmdline-tools/latest + platform-tools + emulator。
# 不写在这里、也不 export 时，脚本兜底 $HOME/android-sdk。
ANDROID_HOME=~/android-sdk

# JDK 21 根目录（含 bin/java、bin/keytool）。
# 留空 = 从 PATH 里的 java 反推（readlink -f 后取上两级）。
JAVA_HOME=

# build-tools 档位：必须显式钉住，脚本不再用 build-tools/* 通配取最大版本
# （装了 36.0.0 就静默换 aapt2 = 人工核对的工具和实际出包的工具不是同一个）。
# 未设置或目录不存在 → 构建直接失败，并列出本机已安装档位。
BUILD_TOOLS_VERSION=35.0.0

# 版本闸门：java 主版本低于它直接失败（错误信息形如「需要 21，当前 17」）。
REQUIRED_JAVA_MAJOR=21

# node 主版本低于它时出声警告（与 package.json 的 engines.node 对齐；
# engines 本身在 pnpm install 时只警告、不硬失败）。
REQUIRED_NODE_MAJOR=22
