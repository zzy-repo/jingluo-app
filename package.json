{
  "name": "deepseek-app",
  "version": "1.4.6",
  "androidVersionCode": 25,
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 83",
    "edge >= 83",
    "safari >= 16",
    "firefox >= 110"
  ],
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build.mjs",
    "build:internal": "node scripts/build.mjs --internal",
    "type": "tsc -p tsconfig.json",
    "check:legacy": "node scripts/check-bundle-syntax.mjs",
    "check:bundle-target": "node scripts/check-bundle-target.mjs",
    "check:case-collision": "node scripts/check-case-collision.mjs",
    "check:db-version": "node scripts/check-db-version.mjs",
    "check:matrix": "node scripts/compat/check-matrix-config.mjs && node scripts/compat/matrix-scan.mjs",
    "check:syntax-floor": "node scripts/compat/check-syntax-floor.mjs",
    "check:compat-baseline": "node scripts/check-compat-baseline.mjs",
    "check:ip": "node scripts/check-hardcoded-ip.mjs",
    "check:guard": "node scripts/check-guard-es5.mjs",
    "check:dup-impl": "node scripts/check-duplicate-impl.mjs",
    "check:test-layout": "node scripts/check-test-layout.mjs",
    "check:test-duplication": "node scripts/check-test-duplication.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:eol": "node scripts/check-eol.mjs",
    "check:identity": "node scripts/check-identity.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check:consume-api": "node scripts/check-consume-api.mjs",
    "check:test-seam": "node scripts/check-test-seam.mjs",
    "check:icon": "node scripts/check-icon-edges.mjs",
    "check:apk": "node scripts/check-apk-debuggable.mjs",
    "verify:apk": "node scripts/verify-release-apk.mjs",
    "check:keystore": "node scripts/check-keystore-config.mjs",
    "check:manifest": "node scripts/check-manifest-fixtures.mjs",
    "check:retention": "node scripts/check-retention.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:grapheme": "node scripts/gen-grapheme-tables.mjs",
    "shot:mobile": "node scripts/shot-mobile.mjs",
    "shot:consume-panels": "node scripts/shot-consume-panels.mjs",
    "mock:sub2api": "node tools/mock-sub2api/server.mjs",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "release:check": "node scripts/release-check.mjs",
    "release:upload": "node scripts/release-upload.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:private": "node scripts/publish-private-apk.mjs",
    "test": "node tests/run-layer.mjs unit",
    "test:fast": "node scripts/test-fast.mjs",
    "test:full": "node scripts/test-full.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "test:report": "node scripts/test-report.mjs",
    "test:integration": "node tests/run-layer.mjs integration",
    "test:integration:baseline": "node tests/run-layer.mjs integration --baseline",
    "test:regression": "node tests/run-layer.mjs regression",
    "test:e2e": "node tests/run-layer.mjs e2e",
    "test:device": "node tests/run-layer.mjs device",
    "test:doc": "node --test --import ./tests/helpers/injected.mjs tests/unit/txt-parser-480.test.mjs tests/unit/docx-parser-480.test.mjs tests/unit/pdf-parser-480.test.mjs tests/unit/pdf-parser-partial-480.test.mjs tests/unit/attachment-character-count-480.test.mjs tests/unit/attachment-context-builder-480.test.mjs tests/unit/attachment-doc-wiring-480.test.mjs tests/unit/attachment-store-572.test.mjs tests/unit/attachment-failure-copy-574.test.mjs tests/unit/attachment-preserve-import-531.test.mjs tests/unit/export-selected-native-536.test.mjs",
    "test:golden": "node tests/run-golden.mjs",
    "test:all": "npm run test && npm run test:regression && npm run test:integration",
    "test:which": "node tests/which.mjs",
    "test:dl-release": "node --test deploy/dl-release/test/*.test.mjs",
    "gen:gap": "node scripts/gen-flex-gap-fallback.mjs",
    "check:gap": "node scripts/check-css-gap-fallback.mjs",
    "check:focus": "node scripts/check-focus-visible-fallback.mjs",
    "check:gutter": "node scripts/check-scrollbar-gutter-fallback.mjs",
    "check:container": "node scripts/check-container-query-fallback.mjs",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "gen:capabilities": "node scripts/gen-capabilities-docs.mjs",
    "check:capabilities-docs": "node scripts/gen-capabilities-docs.mjs --check",
    "check:doc-refs": "node scripts/check-doc-refs.mjs",
    "check:ui-shots": "node scripts/check-ui-shots.mjs",
    "check:limits": "node scripts/check-limits.mjs",
    "check:log-coverage": "node scripts/check-log-coverage.mjs",
    "check:redact": "node scripts/check-redact.mjs",
    "check:hardcoded-ports": "node scripts/check-hardcoded-ports.mjs",
    "check:refactor-direction": "node scripts/check-refactor-direction.mjs",
    "check:webroot-hygiene": "node scripts/check-webroot-hygiene.mjs",
    "check:private-publish-root": "node scripts/check-private-publish-root.mjs",
    "check:public-artifact-redaction": "node scripts/check-public-artifact-redaction.mjs",
    "measure:scroll-shift": "node scripts/measure-narrow-scroll-shift.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "8.0.5",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "pdfjs-dist": "2.16.105",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "fake-indexeddb": "6.2.8",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
