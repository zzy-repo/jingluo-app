{
  "name": "deepseek-app",
  "version": "1.4.0-beta.10",
  "androidVersionCode": 17,
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 83",
    "edge >= 83",
    "safari >= 16",
    "firefox >= 110"
  ],
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build.mjs",
    "build:internal": "node scripts/build.mjs --internal",
    "type": "tsc -p tsconfig.json",
    "check:legacy": "node scripts/check-bundle-syntax.mjs",
    "check:bundle-target": "node scripts/check-bundle-target.mjs",
    "check:matrix": "node scripts/compat/check-matrix-config.mjs && node scripts/compat/matrix-scan.mjs",
    "check:compat-baseline": "node scripts/check-compat-baseline.mjs",
    "check:ip": "node scripts/check-hardcoded-ip.mjs",
    "check:guard": "node scripts/check-guard-es5.mjs",
    "check:dup-impl": "node scripts/check-duplicate-impl.mjs",
    "check:test-layout": "node scripts/check-test-layout.mjs",
    "check:test-duplication": "node scripts/check-test-duplication.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:identity": "node scripts/check-identity.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "check:icon": "node scripts/check-icon-edges.mjs",
    "check:apk": "node scripts/check-apk-debuggable.mjs",
    "check:keystore": "node scripts/check-keystore-config.mjs",
    "check:manifest": "node scripts/check-manifest-fixtures.mjs",
    "gen:grapheme": "node scripts/gen-grapheme-tables.mjs",
    "shot:mobile": "node scripts/shot-mobile.mjs",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "release:check": "node scripts/release-check.mjs",
    "release:upload": "node scripts/release-upload.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test": "node tests/run-layer.mjs unit",
    "test:integration": "node tests/run-layer.mjs integration",
    "test:integration:baseline": "node tests/run-layer.mjs integration --baseline",
    "test:regression": "node tests/run-layer.mjs regression",
    "test:e2e": "node tests/run-layer.mjs e2e",
    "test:device": "node tests/run-layer.mjs device",
    "test:golden": "node tests/run-golden.mjs",
    "test:all": "npm run test && npm run test:regression && npm run test:integration",
    "test:which": "node tests/which.mjs",
    "test:dl-release": "node --test deploy/dl-release/test/*.test.mjs",
    "gen:gap": "node scripts/gen-flex-gap-fallback.mjs",
    "check:gap": "node scripts/check-css-gap-fallback.mjs",
    "check:focus": "node scripts/check-focus-visible-fallback.mjs",
    "check:gutter": "node scripts/check-scrollbar-gutter-fallback.mjs",
    "check:container": "node scripts/check-container-query-fallback.mjs",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "check:docs": "node scripts/check-doc-refs.mjs",
    "check:docrefs": "node scripts/check-doc-refs.mjs",
    "check:limits": "node scripts/check-limits.mjs",
    "check:log-coverage": "node scripts/check-log-coverage.mjs",
    "check:redact": "node scripts/check-redact.mjs",
    "measure:scroll-shift": "node scripts/measure-narrow-scroll-shift.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "8.0.5",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
