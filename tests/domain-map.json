        "android/app/src/main/java/com/example/deepseekchat/AppUpdatePlugin.java": ["tests/unit/domain10-native-progress-order.test.mjs", "tests/unit/domain10-variant-matrix.test.mjs"],
        "android/app/src/main/java/com/example/deepseekchat/UpdateEndpoint.java": ["tests/unit/domain10-variant-matrix.test.mjs"]
      },
      "tests": {
        "unit": ["tests/unit/domain10-gate-wiring.test.mjs", "tests/unit/domain10-variant-matrix.test.mjs"],
        "regression": ["tests/regression/issue-95-legacy-bundle-no-dist.test.mjs"],
        "integration": ["tests/integration/internal-build.test.mjs"],
        "golden": ["tests/golden/g10-update.test.mjs"]
      }
    }
  ],
  "fallback": {
    "note": "不在 10 个域里的改动怎么办（宁可多跑，不静默跳过）",
    "rules": [
      { "match": "^docs/|\\.md$", "run": [], "why": "文档改动 → 不跑用例（L0 只跑 tsc + lint）" },
      { "match": "^tests/.+\\.test\\.mjs$", "run": ["$self"], "why": "改用例本身 → 只跑它自己" },
      { "match": "^src/", "run": ["tests/unit"], "why": "src/ 下没命中任何域 → 回落 unit 全量（与 tests/which.mjs 的回落口径一致）" },
      { "match": "^android/", "run": ["tests/unit"], "why": "原生改动：node 层只跑 unit，真机用例属 device 层（不跑）" },
      { "match": "^(scripts|deploy|shared|config)/", "run": ["tests/unit"], "why": "构建/发布/配置脚本改动 → 回落 unit 全量" }
    ]
  }
}
