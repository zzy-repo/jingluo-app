[Unit]
Description=dl-release — APK 发布接口 (dl.rose7.cn/api/v1/release)
Documentation=https://github.com/zzy-repo/deepseek-app/blob/main/docs/dl-release-api.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/dl-release
ExecStart=/opt/node-current/bin/node /opt/dl-release/server.mjs
Restart=always
RestartSec=2

Environment=NODE_ENV=production
Environment=DL_LISTEN_HOST=127.0.0.1
Environment=DL_LISTEN_PORT=8799
Environment=DL_TOKEN_FILE=/etc/dl-release/token
Environment=DL_APK_DIR=/var/www/dl/apk
Environment=DL_RELEASES_JSON=/var/www/dl/releases.json
# webroot（公网站点根）：只用来判「私有清单/私有包目录不许落在里面」（#609 G1 / #620）
Environment=DL_WEBROOT=/var/www/dl
# 私有清单与私有包目录（#620：POST /api/v1/release/private 写这里）—— **webroot 之外**，
# Caddy 的 file_server 够不着。服务启动时会核一遍：落在 webroot 内就直接拒绝启动。
# 私有（internal）分发目录（#621 按线上实际布局钉死）：包在 /opt/dl-private/apk（公网 404），
# 清单在 /var/www/dl-private/（webroot /var/www/dl 之外，file_server 够不着）。
Environment=DL_PRIVATE_ROOT=/opt/dl-private
Environment=DL_PRIVATE_RELEASES_JSON=/var/www/dl-private/releases.internal.json
Environment=DL_PRIVATE_APK_DIR=/opt/dl-private/apk
# 私有读端点的限流（按 IP，每分钟）：内测客户端轮询清单用，与发布的 2/min 分开计
Environment=DL_PRIVATE_READ_RATE_LIMIT_MAX=60
Environment=DL_PUBLIC_BASE=https://dl.rose7.cn
Environment=DL_AAPT2=/opt/dl-release/bin/aapt2
Environment=DL_REQUIRED_PACKAGE=com.example.deepseekchat
Environment=DL_RATE_LIMIT_MAX=2
Environment=DL_RATE_LIMIT_WINDOW_S=60
# 构建变体：APK 内标记名 + 服务器侧 sha256 白名单（历史包补救通道）
Environment=DL_VARIANT_MARKER=com.example.deepseekchat.ARTIFACT_VARIANT
Environment=DL_VARIANTS_FILE=/etc/dl-release/artifact-variants.json

# 日志只走 journald（journalctl -u dl-release），不落文件、不打印令牌
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dl-release

# 轻量加固：可写仅 /var/www/dl（公网清单）、/var/www/dl-private（私有清单）与 /opt/dl-private
# （私有包目录），以及私有 /tmp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/dl /var/www/dl-private /opt/dl-private
ReadOnlyPaths=/etc/dl-release /opt/dl-release
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
